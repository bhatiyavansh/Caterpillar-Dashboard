# Person B backend (copy to backend/.env; never commit the real one)
# NOTE: the loader does not strip inline comments — keep values on their own line.
COPILOT_PORT=8000
# Relative paths resolve against backend/, not the shell's cwd.
COPILOT_DB_PATH=data/copilot.db
SIMULATOR_URL=http://localhost:8100
COPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM providers. LLM_PROVIDER=auto (default) tries Groq -> Gemini -> Anthropic,
# using whichever keys are present. Groq also provides speech-to-text (/api/stt).
# For Gemini, GOOGLE_API_KEY is accepted as an alias for GEMINI_API_KEY.
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# LLM_PROVIDER=groq
USE_CACHED_RESPONSES=false
